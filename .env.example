# Copy to .env and fill in. NEVER commit .env — it holds your private key.
#   cp .env.example .env

# --- required ---
# Private key of your signer wallet (the key that signs orders).
PK=

# Your Polymarket address. For proxy/deposit accounts (signature_type 1/2/3 in
# config/config.toml) this is the DEPOSIT address that holds your USDC — shown
# on your Polymarket profile / developer page — NOT the signer EOA.
BROWSER_ADDRESS=

# --- optional ---
# Override the Polygon RPC from config.toml.
#POLYGON_RPC=

# Webhook (e.g. Slack/Discord) for kill-switch and halt alerts.
#ALERT_WEBHOOK_URL=

# Builder API creds + relayer, only needed to merge YES+NO pairs back to USDC
# through a V2 DepositWallet (sig_type 1/3). Self-generated via L2 auth. See
# src/polymaker/merge.py.
#POLY_BUILDER_KEY=
#POLY_BUILDER_SECRET=
#POLY_BUILDER_PASSPHRASE=
#POLY_RELAYER_URL=https://relayer-v2.polymarket.com
